# Variables de build (Vite las fija en el bundle al hacer npm run build). Ver README.

# API pública y WebSocket. Por defecto /api en el mismo host (NGINX).
# VITE_API_URL=/api
# VITE_WS_URL=wss://snippets.example.com/api

# Login OIDC (Authorization Code + PKCE)
VITE_OIDC_AUTHORITY=https://<tenant>.us.auth0.com/
VITE_OIDC_CLIENT_ID=<client id de la aplicación SPA>
VITE_OIDC_AUDIENCE=<identifier de la API de Auth0>
# VITE_OIDC_REDIRECT_URI=http://localhost:8080
# VITE_OIDC_SCOPE=openid profile email offline_access

# true: sin backend ni login, con datos de prueba en memoria
# VITE_FAKE_API=false
